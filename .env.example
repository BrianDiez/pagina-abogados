# ── Frontend (Vite) ──────────────────────────────────────────
# 'demo' (default): datos seed locales, sin servicios externos.
# 'neon': API serverless /api + Neon + Clerk + R2 (ver SETUP-NEON.md).
VITE_BACKEND=demo
VITE_CLERK_PUBLISHABLE_KEY=

# ── Server-side (Vercel env vars, NUNCA con prefijo VITE) ────
# Neon: connection string pooled (Dashboard -> Connection Details)
DATABASE_URL=
# Clerk: API Keys -> Secret key
CLERK_SECRET_KEY=
# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=legalhub
R2_PUBLIC_URL=
